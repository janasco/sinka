# --- Source mailbox (the inbox you already use as primary) ---
# IMAP fetch needs an App Password, NOT your normal Gmail password.
# Google Account > Security > 2-Step Verification ON > App passwords > create one.
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=

# --- Fan-out destinations (replicated copies go here) ---
# Comma-separated. This is the list you gave: team inboxes get the same mail
# that lands in you@example.com (incl. forwards from *@example.com).
FORWARD_LIST=team1@example.com,team2@example.com,team3@example.com,team4@example.com,team5@example.com,team6@example.com,team7@example.com,team8@example.com,team9@example.com,team10@example.com

# --- Polling ---
# How often to check for new mail (ms). 300000 = every 5 minutes.
# 60s polling is safe for Gmail IMAP, but 5 min is gentler and plenty
# for a replicator (Gmail can throttle rapid short-lived connections).
POLL_INTERVAL_MS=300000
# Only replicate mail newer than this on first run (hours). Prevents mass backfill.
LOOKBACK_HOURS=24

# --- Destinations (copies are APPENDED here via IMAP, Thunderbird-style) ---
# Raw bytes go straight into each inbox below. No sending, no send caps,
# DKIM can never fail. Needs one App Password per destination
# (each inbox: Google Account > 2-Step ON > App passwords, IMAP enabled).
# user:password pairs separated by ';' (password spaces optional).
# Prefix an entry with '-' to DISABLE it while keeping the password, e.g.
# "-team3@example.com:somepass" receives nothing until '-' is removed.
DEST_SINKS=team1@example.com:;team2@example.com:;team3@example.com:;team4@example.com:;team5@example.com:;team6@example.com:;team7@example.com:;team8@example.com:;team9@example.com:;team10@example.com:

# --- Local web UI (this is what sinka.example.com tunnels to) ---
# In production this port is NOT public — Cloudflare Tunnel + Access Email OTP sits in front.
PORT=8788
DATA_DIR=./data
# Optional extra guard in addition to Access (Bearer token for /api/*).
# Leave empty to rely on Cloudflare Access only.
ADMIN_TOKEN=
# Set to 1 to log what WOULD be forwarded without actually sending.
DRY_RUN=0

# Outage alerting (ntfy.sh push when polls keep failing; empty = disabled).
ALERT_NTFY_TOPIC=sinka-alerts-CHANGE-ME
# Consecutive poll errors before the one-shot alert fires.
ALERT_THRESHOLD=3
